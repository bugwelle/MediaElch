FROM debian:trixie AS base

ENV TZ=Europe/London

# Docker Image for building MediaElch using MXE
#   MXE:       https://github.com/mxe/mxe/
#   MediaElch: https://mediaelch.github.io/mediaelch-doc/
#
# Note: This image can take more than _four_ hours to build!

# First `apt-get install` is the list from
# <https://mxe.cc/#requirements-debian>.
# Second `apt-get install` are dependencies that are _also_
# required but were not listed.
# Third `apt-get install` are dependencies that we need for
# packaging.
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        autopoint \
        bash \
        bison \
        bzip2 \
        curl \
        ca-certificates \
        clang \
        flex \
        g++ \
        g++-multilib \
        gettext \
        git \
        gperf \
        intltool \
        libc6-dev-i386 \
        libgdk-pixbuf-2.0-dev \
        libclang-dev \
        libpcre2-dev \
        llvm-dev \
        libltdl-dev \
        libssl-dev \
        libtool-bin \
        libxml-parser-perl \
        lzip \
        make \
        openssl \
        p7zip-full \
        patch \
        perl \
        python3 \
        python3-mako \
        python3-yaml \
        python3-packaging \
        python3-pkg-resources \
        python3-setuptools \
        python-is-python3 \
        ruby \
        sed \
        sqlite3 \
        unzip \
        wget \
        xz-utils \
        libgl-dev \
        gtk-doc-tools && \
    apt-get install -y --no-install-recommends \
        zip openssl openssh-client && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Download MXE
FROM base AS builder
RUN mkdir /build
WORKDIR /build
RUN git clone --depth=1 https://github.com/mxe/mxe.git

# Build cross environment
#   We build Compilers and some other libraries that are required for Qt.
#
# Keep common dependencies in separate layers so both Qt images can reuse them.
RUN cd /build/mxe && make MXE_TARGETS='x86_64-w64-mingw32.shared' --jobs 4 JOBS=4 cc zlib gnutls
RUN cd /build/mxe && make MXE_TARGETS='x86_64-w64-mingw32.shared' --jobs 2 JOBS=4 mesa cmake fontconfig
RUN cd /build/mxe && make MXE_TARGETS='x86_64-w64-mingw32.shared' --jobs 4 JOBS=4 qt6-qtbase \
                 qt6-qttools \
                 qt6-qtimageformats \
                 qt6-qtmultimedia \
                 qt6-qttranslations \
                 qt6-qtsvg \
                 qt6-qt5compat \
           && make clean-junk \
           && rm -rf /build/mxe/src /build/mxe/log /build/mxe/pkg /build/mxe/.git /build/mxe/.ccache

# Keep sources, logs, downloads, and compiler caches out of the final image.
FROM base
COPY --from=builder /build/mxe/usr /build/mxe/usr

# Enhance path
ENV PATH=/build/mxe/usr/bin:$PATH

# Add qmake and CMake aliases
RUN ln -s /build/mxe/usr/bin/x86_64-w64-mingw32.shared-qt6-qmake /build/mxe/usr/bin/qmake && \
    ln -s /build/mxe/usr/bin/x86_64-w64-mingw32.shared-cmake /build/mxe/usr/bin/cmake

RUN mkdir /src && \
    groupadd -g 10001 mediaelch && \
    useradd -u 10000 -g mediaelch mediaelch && \
    chown -R mediaelch:mediaelch /src

USER mediaelch:mediaelch

WORKDIR /src
VOLUME /src
